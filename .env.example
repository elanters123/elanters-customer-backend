PORT=3050
NODE_ENV=development

# MongoDB — same cluster as customer-app-backend
MONGO_URI=

# JWT secrets — isolated per app
CUSTOMER_JWT_SECRET=
CUSTOMER_JWT_REFRESH_SECRET=

# Secret token for client validation
SECRET_TOKEN_KEY=

# SMS — Fast2SMS
FAST_SMS_API=

# Google Play review login (fixed OTP for allowlisted phones only; SMS skipped)
PLAY_REVIEW_PHONES=7065432173
PLAY_REVIEW_OTP=123456

# Razorpay (RAZ_ID/RAZ_SECRET or RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET)
RAZ_ID=
RAZ_SECRET=

# CORS origins (comma-separated for multiple)
WEB_CLIENT_URL=http://localhost:3000
MOBILE_CLIENT_URL=*

# Public API base for product image URLs returned in catalog/cart JSON
# Example: http://13.126.90.213:8080/customer/api
# If unset, derived from the incoming request Host header.
PUBLIC_API_URL=
